# Copy to .env for local overrides. docker compose reads this file for interpolation.
# Never commit real keys.

DATABASE_URL=postgresql://platequote:platequote@localhost:54329/platequote
SLICER_WORKER_URL=http://127.0.0.1:8091
# Dev-only shared secret. docker compose uses this when the variable is unset.
# Render generates a real value and shares it with the web app and the worker.
SLICER_WORKER_TOKEN=platequote-dev-worker
UPLOAD_DIR=./data/uploads

# Shop admin. Both are required or admin stays locked.
# These dev values only work with `npm run dev` (NODE_ENV=development).
# They are refused whenever NODE_ENV=production, and on Render. That includes
# `next start` and docker compose: the web image sets NODE_ENV=production, so
# compose's built-in defaults leave admin locked.
# For docker compose or `next start`, set real local values instead, e.g.
#   ADMIN_PASSWORD=<any 8+ chars that is not platequote-dev>
#   ADMIN_SESSION_SECRET=$(openssl rand -hex 32)   # paste the output, 16+ chars
# in a .env file next to docker-compose.yml (compose reads it), then
# `docker compose up -d --build web`. On Render, set a unique password in the
# dashboard (ADMIN_SESSION_SECRET is generated for you).
ADMIN_PASSWORD=platequote-dev
ADMIN_SESSION_SECRET=platequote-dev-session-secret

# PayPal sandbox only. Create these in the PayPal Developer Dashboard.
# Leave them empty to run quotes without checkout.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Local webhook tests only. Leave unset unless you are posting fixtures by hand.
PAYPAL_ALLOW_UNVERIFIED_WEBHOOKS=

# LLM review. mock (or a blank key) uses the built-in reviewer.
# openai uses LLM_BASE_URL (default https://api.openai.com/v1) and LLM_MODEL (default gpt-4o-mini).
# anthropic uses LLM_MODEL (default claude-sonnet-4-5).
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
