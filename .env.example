# Copy to .env for local overrides. docker compose reads this file for interpolation.
# Never commit real keys.

DATABASE_URL=postgresql://platequote:platequote@localhost:54329/platequote
SLICER_WORKER_URL=http://127.0.0.1:8091
UPLOAD_DIR=./data/uploads

# PayPal sandbox only. Create these in the PayPal Developer Dashboard.
# Leave them empty to run quotes without checkout.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Local webhook tests only. Leave unset unless you are posting fixtures by hand.
PAYPAL_ALLOW_UNVERIFIED_WEBHOOKS=

# LLM review. mock (or a blank key) uses the built-in reviewer.
# openai uses LLM_BASE_URL (default https://api.openai.com/v1) and LLM_MODEL (default gpt-4o-mini).
# anthropic uses LLM_MODEL (default claude-sonnet-4-5).
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
